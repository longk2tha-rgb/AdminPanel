{
    "name": "unified-admin-panel",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --port 5174",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "electron": "npm run build && electron .",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5174 && electron .\"",
        "dist": "npm run build && electron-builder -w",
        "update": "powershell -ExecutionPolicy Bypass -File ./publish.ps1",
        "deploy": "npm run build && firebase deploy --only hosting",
        "generate-icons": "node scripts/generate-icon.mjs"
    },
    "build": {
        "appId": "com.unified.adminpanel",
        "productName": "Unified Admin Panel",
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asar": true,
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Admin Panel"
        },
        "publish": {
            "provider": "github",
            "owner": "longk2tha-rgb",
            "repo": "AdminPanel",
            "releaseType": "release"
        }
    },
    "dependencies": {
        "electron-updater": "^6.6.2",
        "firebase": "^10.7.1",
        "lucide-react": "^0.263.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "png-to-ico": "^3.0.1",
        "sharp": "^0.34.5",
        "typescript": "^5.3.3",
        "vite": "^5.0.10",
        "wait-on": "^7.2.0"
    }
}